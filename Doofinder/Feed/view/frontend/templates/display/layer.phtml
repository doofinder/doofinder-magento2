<?php /** @var \Doofinder\Feed\Block\Display\Layer $block */ ?>
<script<?= /* @noEscape */ $block->getNonceAttribute() ?>>
    var dfPageType = <?= /* @noEscape */ json_encode($block->getPageType()) ?>;
    var dfProductId = <?= /* @noEscape */ json_encode($block->getDfProductId()) ?>;
    var dfCategoryName = <?= /* @noEscape */ json_encode($block->getDfCategoryName()) ?>;
</script>
<script<?= /* @noEscape */ $block->getNonceAttribute() ?>>
    // Copies the Doofinder session to a cookie, which the module reads on the order success page to
    // send the sale. It runs on load and again on every click and form submission, as the first page
    // the loader runs in creates the session after this script.
    (function () {
        function writeSession() {
            var session = JSON.parse(localStorage.getItem("df-session"));
            var userId = JSON.parse(localStorage.getItem("df-random-userid"));
            if (!session || !userId) return;

            var config = window.Doofinder && window.Doofinder.getConfig ? window.Doofinder.getConfig() : {};
            var value = JSON.stringify({ session_id: session.id, user_id: userId, hashid: config.hashid });
            document.cookie = "doofinder_session=" + encodeURIComponent(value) +
                "; path=/; max-age=86400; SameSite=Lax" + (location.protocol === "https:" ? "; Secure" : "");
        }

        writeSession();
        document.addEventListener("click", writeSession, true);
        document.addEventListener("submit", writeSession, true);
    })();
</script>
<?= /* @noEscape */ $block->getDisplayLayer(); ?>
